# NodeMesh — Workflow B: the whole cluster in Docker on the Dell.
#
#     python3 scripts/init_env.py --cluster   # writes .env.cluster with generated secrets
#     docker compose --env-file .env.cluster -f compose.yaml -f compose.dell.yaml up -d --build
#
# Never commit the real file.

NODEMESH_VERSION=dev

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=<generated>
# Add the Dell's LAN name/IP if you expose the coordinator beyond loopback.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to true only behind TLS (reverse proxy); enables secure cookies.
DJANGO_HTTPS=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=8080

# --- PostgreSQL: existing container on the Dell (compose.dell.yaml) ----------------
POSTGRES_DOCKER_NETWORK=<name of the network postgres-distributed is attached to>
POSTGRES_CONTAINER_HOST=postgres-distributed
POSTGRES_DB=distributed_storage
POSTGRES_USER=storage_admin
POSTGRES_PASSWORD=<fill-in>

# --- PostgreSQL: throwaway test database (compose.test.yaml) ------------------------
TEST_POSTGRES_PASSWORD=<generated>

# --- Replication and nodes -----------------------------------------------------------
NODEMESH_REPLICATION_FACTOR=3
NODEMESH_WRITE_QUORUM=2
NODEMESH_MAX_UPLOAD_BYTES=104857600
NODE_MIN_FREE_BYTES=268435456
NODEMESH_RECONCILE_INTERVAL=30
NODE_KEY_ID=k1
NODE_1_HMAC_SECRET=<generated>
NODE_2_HMAC_SECRET=<generated>
NODE_3_HMAC_SECRET=<generated>
NODE_4_HMAC_SECRET=<generated>
