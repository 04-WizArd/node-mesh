# NodeMesh — Workflow B: the Docker cluster (see docs/deployment.md).
#
#     make cluster-env        # writes .env.cluster from this file with generated secrets (mode 0600)
#
# Then fill in the three PostgreSQL values marked <fill-in>. Never commit the real file.

# Image tag for the locally built images.
NODEMESH_VERSION=dev

# Compose names containers and VOLUMES after the project, which defaults to the
# repository directory name (e.g. node-mesh_node-1-data). Leave this unset on an
# existing deployment: changing it later points the cluster at NEW, empty volumes.
# COMPOSE_PROJECT_NAME=nodemesh

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=<generated>
# Extra host names the coordinator answers to (localhost and 127.0.0.1 are always
# allowed). Add the server's DNS name if you expose it beyond loopback.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# true only behind a TLS reverse proxy: enables secure cookies.
DJANGO_HTTPS=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
# Loopback by default; reach it from another machine through an SSH tunnel.
COORDINATOR_BIND=127.0.0.1
COORDINATOR_PORT=8080

# --- PostgreSQL: an existing container on this host (compose.external-db.yaml) --
# Network the PostgreSQL container is attached to, and its container name.
POSTGRES_DOCKER_NETWORK=<fill-in>
POSTGRES_CONTAINER_HOST=<fill-in>
# A database used ONLY by this cluster. Never share it with a development
# coordinator (docs/deployment.md, "Separate databases").
POSTGRES_DB=nodemesh
POSTGRES_USER=nodemesh
POSTGRES_PASSWORD=<fill-in>

# --- PostgreSQL: throwaway test database (make cluster-test-*) -------------------
TEST_POSTGRES_PASSWORD=<generated>

# --- Replication, nodes and reconciliation -----------------------------------------
NODEMESH_REPLICATION_FACTOR=3
NODEMESH_WRITE_QUORUM=2
NODEMESH_MAX_UPLOAD_BYTES=104857600
NODE_MIN_FREE_BYTES=268435456
NODEMESH_RECONCILE_INTERVAL=30
# The reconciler turns unhealthy when no cycle has succeeded for this long.
NODEMESH_RECONCILER_MAX_SILENCE=300
NODE_KEY_ID=k1
NODE_1_HMAC_SECRET=<generated>
NODE_2_HMAC_SECRET=<generated>
NODE_3_HMAC_SECRET=<generated>
NODE_4_HMAC_SECRET=<generated>
