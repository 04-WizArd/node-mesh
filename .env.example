# NodeMesh — Workflow A: local development (see docs/development.md).
# Django and the storage nodes run from the Python virtualenv; PostgreSQL can
# be local or remote (e.g. a server reached through an SSH tunnel).
#
#     make dev-env            # writes .env from this file with generated secrets (mode 0600)
#
# Then set POSTGRES_PASSWORD (and the connection values if they differ).
# Never commit the real file.

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=<generated>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=false

# --- PostgreSQL ------------------------------------------------------------------
# 127.0.0.1:15432 is the local end of an SSH tunnel such as
#   ssh -N -L 15432:127.0.0.1:5432 <user>@<db-server>
# Use a development database of its own: never the Docker cluster's database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=nodemesh_dev
POSTGRES_USER=nodemesh
POSTGRES_PASSWORD=<fill-in>
POSTGRES_SSLMODE=prefer

# --- Replication ------------------------------------------------------------------
NODEMESH_REPLICATION_FACTOR=3
NODEMESH_WRITE_QUORUM=2
NODEMESH_MAX_UPLOAD_BYTES=104857600
NODEMESH_NODE_CONNECT_TIMEOUT=3
NODEMESH_NODE_READ_TIMEOUT=30

# --- Local storage nodes (make dev-nodes) ---------------------------------------------
# One secret per node; the coordinator and the node must share it.
NODE_KEY_ID=k1
NODE_1_HMAC_SECRET=<generated>
NODE_2_HMAC_SECRET=<generated>
NODE_3_HMAC_SECRET=<generated>
NODE_4_HMAC_SECRET=<generated>
NODEMESH_NODE_CREDENTIALS=<generated from the secrets above>
NODEMESH_NODES=node-1=http://127.0.0.1:8101,node-2=http://127.0.0.1:8102,node-3=http://127.0.0.1:8103
