# NodeMesh — Workflow A: Django runs on the Mac, PostgreSQL runs on the Dell
# and is reached through the SSH tunnel (127.0.0.1:15432 -> Dell 127.0.0.1:5432).
#
# Create your real file with generated secrets (never commit it):
#     python scripts/init_env.py            # writes .env from this template
# then fill in POSTGRES_PASSWORD yourself.

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=<generated>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=false

# --- PostgreSQL (development database on the Dell, via the SSH tunnel) ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=distributed_storage
POSTGRES_USER=storage_admin
POSTGRES_PASSWORD=<fill-in>
POSTGRES_SSLMODE=prefer

# --- Replication ------------------------------------------------------------------
NODEMESH_REPLICATION_FACTOR=3
NODEMESH_WRITE_QUORUM=2
NODEMESH_MAX_UPLOAD_BYTES=104857600
NODEMESH_NODE_CONNECT_TIMEOUT=3
NODEMESH_NODE_READ_TIMEOUT=30

# --- Local storage nodes (scripts/run_nodes.py) ---------------------------------------
# One secret per node; the coordinator and the node must share it.
NODE_KEY_ID=k1
NODE_1_HMAC_SECRET=<generated>
NODE_2_HMAC_SECRET=<generated>
NODE_3_HMAC_SECRET=<generated>
NODE_4_HMAC_SECRET=<generated>
NODEMESH_NODE_CREDENTIALS=<generated from the secrets above>
NODEMESH_NODES=node-1=http://127.0.0.1:8101,node-2=http://127.0.0.1:8102,node-3=http://127.0.0.1:8103
